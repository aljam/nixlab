{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Group all Nix flake input updates",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs"
    },
    {
      "description": "Automerge only lockfile-only maintenance",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep higher-risk Nix inputs manual",
      "matchManagers": ["nix"],
      "matchDepNames": [
        "nixpkgs",
        "nixpkgs-stable",
        "nix-cachyos-kernel",
        "hyprland",
        "home-manager"
      ],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
