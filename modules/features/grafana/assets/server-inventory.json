{
  "title": "Server Inventory — Fleet Overview",
  "tags": ["homelab", "inventory"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus"}]},
  "panels": [
    {"id":1,"title":"Node exporter targets online","description":"Targets whose instance label ends in :9100. Counts exporter endpoints, not deduplicated physical hosts.","type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":0,"w":8,"h":4},"targets":[{"refId":"A","expr":"sum(up{instance=~\".*:9100\"} == bool 1)","instant":true}]},
    {"id":2,"title":"Node exporter targets offline","description":"Zero means all currently discovered targets respond. Removed targets are not counted; no data is not a healthy fleet.","type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":8,"y":0,"w":8,"h":4},"targets":[{"refId":"A","expr":"sum(up{instance=~\".*:9100\"} == bool 0)","instant":true}]},
    {"id":3,"title":"Failed systemd units","type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":16,"y":0,"w":8,"h":4},"targets":[{"refId":"A","expr":"sum(node_systemd_unit_state{instance=~\".*:9100\",state=\"failed\"})","instant":true}]},
    {"id":4,"title":"Target inventory and reachability","description":"Value 1 is reachable; 0 is a failed scrape. All target labels are retained for inventory identification.","type":"table","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":4,"w":24,"h":8},"targets":[{"refId":"A","expr":"up{instance=~\".*:9100\"}","instant":true,"format":"table"}]},
    {"id":5,"title":"CPU utilization","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":12,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]},"targets":[{"refId":"A","expr":"100 * (1 - avg by (job, instance) (rate(node_cpu_seconds_total{instance=~\".*:9100\",mode=\"idle\"}[$__rate_interval])))","legendFormat":"{{job}} / {{instance}}"}]},
    {"id":6,"title":"Filesystem usage","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":12,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]},"targets":[{"refId":"A","expr":"100 * (1 - node_filesystem_avail_bytes{instance=~\".*:9100\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} / (node_filesystem_size_bytes{instance=~\".*:9100\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} > 0))","legendFormat":"{{instance}} {{mountpoint}}"}]}
  ]
}
