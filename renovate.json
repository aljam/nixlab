{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ]
  },
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Group Nix flake lock-file maintenance",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "Nix flake lock file"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
